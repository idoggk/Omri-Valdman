{
  "tasks": [
    {
      "id": "dv-m-01", "subject": "math", "title": "קוסינוס של זווית כפולה מתוך קוסינוס של סכום", "sym": { "a": "α", "b": "β" },
      "start": "ידוע: cos(a+b) = cos a · cos b − sin a · sin b", "goal": "cos(2a) = 2cos²a − 1",
      "vars": { "a": [0.3, 2.8] }, "mode": "identity",
      "goalF": "cos(2*a) = 2*cos(a)^2 - 1",
      "steps": [
        { "f": "cos(a+a) = cos(a)*cos(a) - sin(a)*sin(a)", "n": "מציבים b = a בנוסחת הסכום.",
          "w": [ { "f": "cos(a+a) = cos(a)*cos(a) + sin(a)*sin(a)", "e": "sign" }, { "f": "cos(a+a) = cos(a) + cos(a)", "e": "linear" }, { "f": "cos(a+a) = cos(a)*sin(a) - sin(a)*cos(a)", "e": "swap" } ] },
        { "f": "cos(2*a) = cos(a)^2 - sin(a)^2", "n": "a + a = 2a, ומכפלה של אותו גורם בעצמו היא ריבוע.",
          "w": [ { "f": "cos(2*a) = 2*cos(a)", "e": "linear" }, { "f": "cos(2*a) = cos(a)^2 + sin(a)^2", "e": "sign" }, { "f": "cos(2*a) = cos(a^2) - sin(a^2)", "e": "power" } ] },
        { "f": "sin(a)^2 = 1 - cos(a)^2", "n": "זהות פיתגורס: sin² + cos² = 1. רוצים להיפטר מהסינוס.",
          "w": [ { "f": "sin(a)^2 = 1 + cos(a)^2", "e": "sign" }, { "f": "sin(a)^2 = 1 - cos(a)", "e": "power" }, { "f": "sin(a)^2 = cos(a)^2 - 1", "e": "sign" } ] },
        { "f": "cos(2*a) = cos(a)^2 - (1 - cos(a)^2)", "n": "מציבים את sin² במקום הסינוס, ושומרים על הסוגריים.",
          "w": [ { "f": "cos(2*a) = cos(a)^2 - 1 - cos(a)^2", "e": "paren" }, { "f": "cos(2*a) = cos(a)^2 + 1 - cos(a)^2", "e": "paren" }, { "f": "cos(2*a) = cos(a)^2 - (1 + cos(a)^2)", "e": "sign" } ] },
        { "f": "cos(2*a) = 2*cos(a)^2 - 1", "n": "פותחים סוגריים ומאחדים: cos² + cos² = 2cos².",
          "w": [ { "f": "cos(2*a) = 2*cos(a)^2 + 1", "e": "sign" }, { "f": "cos(2*a) = cos(a)^2 - 1", "e": "dropped" }, { "f": "cos(2*a) = 2*cos(a) - 1", "e": "power" } ] }
      ],
      "key": [1, 2, 3]
    },
