          "w": [ { "f": "sin(a) = 2*sin(a/2) + cos(a/2)", "e": "linear" }, { "f": "sin(a) = sin(a/2)*cos(a/2)", "e": "factor" }, { "f": "sin(a) = 2*sin(a/2)*sin(a/2)", "e": "swap" } ] },
