        { "f": "x^n = b^(n*log_b(x))", "n": "חוק חזקה בחזקה: מכפילים את החזקות.",
          "w": [ { "f": "x^n = b^(n + log_b(x))", "e": "linear" }, { "f": "x^n = b^(log_b(x)^n)", "e": "power" }, { "f": "x^n = b^(n*log_b(x))*b", "e": "factor" } ] },
        { "f": "log_b(x^n) = log_b(b^(n*log_b(x)))", "n": "לוקחים log בבסיס b משני האגפים.",
          "w": [ { "f": "log_b(x^n) = b^(n*log_b(x))", "e": "dropped" }, { "f": "log_b(x^n) = log_b(n*b^(log_b(x)))", "e": "factor" }, { "f": "log_b(x)^n = log_b(b^(n*log_b(x)))", "e": "power" } ] },
        { "f": "log_b(x^n) = n*log_b(x)", "n": "log_b(b^k) = k, ולכן נשארת החזקה עצמה.",
          "w": [ { "f": "log_b(x^n) = log_b(x)^n", "e": "power" }, { "f": "log_b(x^n) = log_b(x) + n", "e": "linear" }, { "f": "log_b(x^n) = x*log_b(n)", "e": "swap" } ] }
      ],
      "key": [1, 2, 3]
    },
    {
      "id": "dv-m-06", "subject": "math", "title": "נוסחת השורשים של משוואה ריבועית: השלמה לריבוע", "sym": {},
      "start": "משוואה ריבועית a·x² + b·x + c = 0, כש־a ≠ 0 וכש־b² − 4ac ≥ 0", "goal": "x = ( −b ± √(b² − 4ac) ) / (2a)",
      "vars": { "a": [0.5, 3], "b": [-3, 3], "c": [-4, 1], "x": [-3, 3] }, "dom": "b^2 - 4*a*c >= 0", "mode": "solve", "unknown": "x", "scan": [-30, 30],
      "startF": "a*x^2 + b*x + c = 0",
      "goalF": "x = (-b + sqrt(b^2-4*a*c))/(2*a) or x = (-b - sqrt(b^2-4*a*c))/(2*a)",
      "steps": [
        { "f": "x^2 + (b/a)*x + c/a = 0", "n": "מחלקים את כל המשוואה ב־a, כל האיברים ולא רק הראשון.",
          "w": [ { "f": "x^2 + b*x + c = 0", "e": "partial" }, { "f": "x^2 + (b/a)*x + c = 0", "e": "partial" }, { "f": "x^2 + b*x + c/a = 0", "e": "partial" } ] },
        { "f": "x^2 + (b/a)*x = -c/a", "n": "מעבירים את האיבר החופשי לאגף ימין, והסימן מתהפך.",
          "w": [ { "f": "x^2 + (b/a)*x = c/a", "e": "sign" }, { "f": "x^2 + (b/a)*x = -c", "e": "partial" }, { "f": "x^2 - (b/a)*x = -c/a", "e": "sign" } ] },
        { "f": "(x + b/(2*a))^2 = b^2/(4*a^2) - c/a", "n": "מוסיפים את ריבוע חצי המקדם, (b/2a)², לשני האגפים.",
          "w": [ { "f": "(x + b/(2*a))^2 = -c/a", "e": "dropped" }, { "f": "(x + b/(2*a))^2 = b^2/(4*a^2) + c/a", "e": "sign" }, { "f": "(x + b/a)^2 = b^2/a^2 - c/a", "e": "factor" } ] },
        { "f": "(x + b/(2*a))^2 = (b^2 - 4*a*c)/(4*a^2)", "n": "מאחדים את האגף הימני למכנה משותף 4a².",
          "w": [ { "f": "(x + b/(2*a))^2 = (b^2 - 4*a*c)/(2*a^2)", "e": "factor" }, { "f": "(x + b/(2*a))^2 = (b^2 + 4*a*c)/(4*a^2)", "e": "sign" }, { "f": "(x + b/(2*a))^2 = (b^2 - 4*a*c)/(4*a)", "e": "power" } ] },
        { "f": "x + b/(2*a) = sqrt(b^2-4*a*c)/(2*a) or x + b/(2*a) = -sqrt(b^2-4*a*c)/(2*a)", "n": "שורש משני האגפים נותן שתי אפשרויות: חיובי ושלילי.", "typed": false,
          "w": [ { "f": "x + b/(2*a) = sqrt(b^2-4*a*c)/(2*a)", "e": "dropped" }, { "f": "x + b/(2*a) = (b^2-4*a*c)/(2*a) or x + b/(2*a) = -(b^2-4*a*c)/(2*a)", "e": "power" }, { "f": "x + b/(2*a) = sqrt(b^2-4*a*c)/(4*a^2) or x + b/(2*a) = -sqrt(b^2-4*a*c)/(4*a^2)", "e": "factor" } ] },
        { "f": "x = (-b + sqrt(b^2-4*a*c))/(2*a) or x = (-b - sqrt(b^2-4*a*c))/(2*a)", "n": "מעבירים את b/(2a) לאגף ימין ומאחדים לשבר אחד.", "typed": false,
          "w": [ { "f": "x = (-b + sqrt(b^2-4*a*c))/(2*a)", "e": "dropped" }, { "f": "x = (b + sqrt(b^2-4*a*c))/(2*a) or x = (b - sqrt(b^2-4*a*c))/(2*a)", "e": "sign" }, { "f": "x = (-b + sqrt(b^2-4*a*c))/2*a or x = (-b - sqrt(b^2-4*a*c))/2*a", "e": "paren" } ] }
      ],
      "key": [1, 2, 3]
    },
    {
      "id": "dv-m-07", "subject": "math", "title": "תנאי המשיקות של ישר ומעגל דרך דיסקרימיננטה", "sym": {},
      "start": "המעגל x² + y² = r² והישר y = m·x + k. הישר משיק כשהמשוואה הריבועית שמתקבלת בהצבה יש לה פתרון יחיד, כלומר Δ = 0", "goal": "k = ±r·√(1 + m²)",
      "vars": { "m": [-2, 2], "r": [1, 3], "k": [-3, 3] }, "mode": "solve", "unknown": "k", "scan": [-30, 30],
      "goalF": "k = r*sqrt(1+m^2) or k = -r*sqrt(1+m^2)",
      "steps": [
        { "f": "(2*m*k)^2 - 4*(1+m^2)*(k^2-r^2) = 0", "n": "ההצבה נותנת (1+m²)x² + 2mk·x + (k² − r²) = 0. הדיסקרימיננטה b² − 4ac מתאפסת.",
          "w": [ { "f": "(2*m*k)^2 + 4*(1+m^2)*(k^2-r^2) = 0", "e": "sign" }, { "f": "2*m*k - 4*(1+m^2)*(k^2-r^2) = 0", "e": "power" }, { "f": "(2*m*k)^2 - 4*(1+m^2)*(k^2+r^2) = 0", "e": "sign" } ] },
        { "f": "4*m^2*k^2 - 4*(k^2 + m^2*k^2 - r^2 - m^2*r^2) = 0", "n": "פותחים את הסוגריים (1+m²)(k²−r²) איבר איבר.",
          "w": [ { "f": "4*m^2*k^2 - 4*(k^2 + m^2*k^2 - r^2) = 0", "e": "cross" }, { "f": "4*m^2*k^2 - 4*k^2 - 4*m^2*k^2 - 4*r^2 - 4*m^2*r^2 = 0", "e": "paren" }, { "f": "2*m*k^2 - 4*(k^2 + m^2*k^2 - r^2 - m^2*r^2) = 0", "e": "factor" } ] },
        { "f": "-4*k^2 + 4*r^2 + 4*m^2*r^2 = 0", "n": "האיברים 4m²k² מצטמצמים.",
          "w": [ { "f": "-4*k^2 + 4*r^2 - 4*m^2*r^2 = 0", "e": "sign" }, { "f": "-4*k^2 + 4*r^2 = 0", "e": "dropped" }, { "f": "4*k^2 + 4*r^2 + 4*m^2*r^2 = 0", "e": "sign" } ] },
        { "f": "k^2 = r^2*(1+m^2)", "n": "מחלקים ב־4, מעבירים את k² ומוציאים r² גורם משותף.",
