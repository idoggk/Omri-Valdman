      ],
      "key": [1, 2, 3]
    },
    {
      "id": "dv-m-03", "subject": "math", "title": "מסכום סינוסים למכפלה, מתוך מכפלה לסכום", "sym": {},
      "start": "ידוע: 2 sin A cos B = sin(A+B) + sin(A−B)", "goal": "sin p + sin q = 2 sin((p+q)/2) cos((p−q)/2)",
      "vars": { "p": [0.2, 3], "q": [0.2, 3] }, "mode": "identity",
      "goalF": "sin(p) + sin(q) = 2*sin((p+q)/2)*cos((p-q)/2)",
      "steps": [
        { "f": "2*sin((p+q)/2)*cos((p-q)/2) = sin((p+q)/2 + (p-q)/2) + sin((p+q)/2 - (p-q)/2)", "n": "מציבים A = (p+q)/2 ו־B = (p−q)/2 בנוסחת המכפלה לסכום.",
          "w": [ { "f": "2*sin((p+q)/2)*cos((p-q)/2) = sin((p+q)/2 + (p-q)/2) - sin((p+q)/2 - (p-q)/2)", "e": "sign" }, { "f": "2*sin((p+q)/2)*cos((p-q)/2) = cos((p+q)/2 + (p-q)/2) + cos((p+q)/2 - (p-q)/2)", "e": "swap" }, { "f": "2*sin((p+q)/2)*cos((p-q)/2) = sin((p+q)/2 + (p-q)/2)*sin((p+q)/2 - (p-q)/2)", "e": "identity" } ] },
        { "f": "(p+q)/2 + (p-q)/2 = p", "n": "A + B: ה־q וה־־q מצטמצמים, ונשארים עם 2p/2.",
          "w": [ { "f": "(p+q)/2 + (p-q)/2 = q", "e": "swap" }, { "f": "(p+q)/2 + (p-q)/2 = p + q", "e": "factor" }, { "f": "(p+q)/2 + (p-q)/2 = 2*p", "e": "factor" } ] },
        { "f": "(p+q)/2 - (p-q)/2 = q", "n": "A − B: עכשיו ה־p מצטמצם. שימו לב לסימן מינוס על כל הסוגריים.",
          "w": [ { "f": "(p+q)/2 - (p-q)/2 = p", "e": "swap" }, { "f": "(p+q)/2 - (p-q)/2 = p + q", "e": "paren" }, { "f": "(p+q)/2 - (p-q)/2 = 0", "e": "paren" } ] },
        { "f": "sin(p) + sin(q) = 2*sin((p+q)/2)*cos((p-q)/2)", "n": "אחרי ההצבה סכום הסינוסים שווה למכפלה.",
          "w": [ { "f": "sin(p) + sin(q) = 2*sin((p-q)/2)*cos((p+q)/2)", "e": "swap" }, { "f": "sin(p) + sin(q) = sin((p+q)/2)*cos((p-q)/2)", "e": "factor" }, { "f": "sin(p) + sin(q) = 2*sin(p+q)*cos(p-q)", "e": "power" } ] }
      ],
      "key": [0, 1, 2]
    },
    {
      "id": "dv-m-04", "subject": "math", "title": "נוסחת המעבר בין בסיסים של לוגריתם", "sym": {},
      "start": "ידוע: log_b(x) = y פירושו b^y = x", "goal": "log_b(x) = log_c(x) / log_c(b)",
      "vars": { "x": [1.5, 9], "b": [1.5, 5], "c": [1.5, 6] }, "mode": "identity",
      "goalF": "log_b(x) = log_c(x)/log_c(b)",
      "steps": [
        { "f": "b^(log_b(x)) = x", "n": "זו ההגדרה של הלוגריתם: החזקה שמעלים בה את b כדי לקבל x.",
          "w": [ { "f": "b^(log_b(x)) = b", "e": "dropped" }, { "f": "x^(log_b(x)) = b", "e": "swap" }, { "f": "b^x = log_b(x)", "e": "invert" } ] },
        { "f": "ln(b^(log_b(x))) = ln(x)", "n": "לוקחים ln משני האגפים (שניהם חיוביים).",
          "w": [ { "f": "ln(b^(log_b(x))) = ln(x) + ln(b)", "e": "linear" }, { "f": "ln(b)^(log_b(x)) = ln(x)", "e": "power" }, { "f": "ln(b^(log_b(x))) = ln(log_b(x))", "e": "premature" } ] },
        { "f": "log_b(x)*ln(b) = ln(x)", "n": "כלל החזקה: ln(b^y) = y·ln(b).",
          "w": [ { "f": "log_b(x) + ln(b) = ln(x)", "e": "linear" }, { "f": "log_b(x)^ln(b) = ln(x)", "e": "power" }, { "f": "log_b(x)*ln(x) = ln(b)", "e": "swap" } ] },
        { "f": "log_b(x) = ln(x)/ln(b)", "n": "מחלקים ב־ln(b), שאינו אפס כי b ≠ 1.",
          "w": [ { "f": "log_b(x) = ln(b)/ln(x)", "e": "invert" }, { "f": "log_b(x) = ln(x) - ln(b)", "e": "linear" }, { "f": "log_b(x) = ln(x/b)", "e": "partial" } ] },
        { "f": "log_b(x) = log_c(x)/log_c(b)", "n": "אותו חישוב עם ln אפשר לעשות בכל בסיס c, כי היחס בין שני לוגריתמים באותו בסיס נשאר.",
          "w": [ { "f": "log_b(x) = log_c(b)/log_c(x)", "e": "invert" }, { "f": "log_b(x) = log_c(x) - log_c(b)", "e": "linear" }, { "f": "log_b(x) = log_c(x)/log_b(c)", "e": "swap" } ] }
      ],
      "key": [1, 2, 3]
    },
    {
      "id": "dv-m-05", "subject": "math", "title": "כלל החזקה בלוגריתם מתוך חוק החזקות", "sym": {},
