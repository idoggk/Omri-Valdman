{
  "tasks": [
    {
      "id": "dv-p-01", "subject": "physics", "title": "משוואות התנועה x(t) ו־y(t) של קליע", "sym": { "th": "θ" },
      "start": "קליע נזרק במהירות v0 בזווית θ מעל האופק, מתחילת הצירים. אין התנגדות אוויר: a_x = 0 ו־ a_y = −g. התאוצה קבועה, ולכן העתק = מהירות ממוצעת · זמן", "goal": "x = v0·cosθ·t , y = v0·sinθ·t − ½·g·t²",
      "vars": { "v0": [5, 30], "th": [0.3, 1.2], "t": [0.1, 3], "g": [9.6, 10] },
      "defs": { "vx": "v0*cos(th)", "vy": "v0*sin(th) - g*t", "x": "(v0*cos(th) + vx)/2*t", "y": "(v0*sin(th) + vy)/2*t" }, "mode": "identity",
      "goalF": "y = v0*sin(th)*t - g*t^2/2",
      "steps": [
        { "f": "vx = v0*cos(th)", "n": "בציר האופקי אין תאוצה, אז הרכיב האופקי של המהירות נשאר כמו שהיה בהתחלה: v0·cosθ.",
          "w": [ { "f": "vx = v0*sin(th)", "e": "axis" }, { "f": "vx = v0*cos(th) - g*t", "e": "quantity" }, { "f": "vx = v0*cos(th)*t", "e": "quantity" } ] },
        { "f": "x = v0*cos(th)*t", "n": "מהירות קבועה: העתק = מהירות · זמן.",
          "w": [ { "f": "x = v0*cos(th)*t^2", "e": "power" }, { "f": "x = v0*sin(th)*t", "e": "axis" }, { "f": "x = v0*cos(th)*t + g*t^2/2", "e": "quantity" } ] },
        { "f": "vy = v0*sin(th) - g*t", "n": "בציר האנכי התאוצה היא −g, ולכן המהירות יורדת ב־g בכל שנייה.",
          "w": [ { "f": "vy = v0*sin(th) + g*t", "e": "sign" }, { "f": "vy = v0*sin(th) - g", "e": "quantity" }, { "f": "vy = v0*cos(th) - g*t", "e": "axis" } ] },
        { "f": "y = ((v0*sin(th) + vy)/2)*t", "n": "מהירות ממוצעת אנכית היא ממוצע ההתחלתית והסופית, כפול הזמן.",
          "w": [ { "f": "y = (v0*sin(th) + vy)*t", "e": "factor" }, { "f": "y = (v0*sin(th) + vy)/2*t^2", "e": "power" }, { "f": "y = ((v0*sin(th) - vy)/2)*t", "e": "sign" } ] },
        { "f": "y = v0*sin(th)*t - g*t^2/2", "n": "מציבים vy: (v0 sinθ + v0 sinθ − g t)/2 · t.",
          "w": [ { "f": "y = v0*sin(th)*t - g*t^2", "e": "factor" }, { "f": "y = v0*sin(th)*t + g*t^2/2", "e": "sign" }, { "f": "y = v0*sin(th)*t - g*t/2", "e": "power" } ] }
      ],
      "key": [1, 2, 3]
    },
    {
      "id": "dv-p-02", "subject": "physics", "title": "זמן הטיסה של קליע שנזרק ממצוק", "sym": { "th": "θ" },
      "start": "קליע נזרק ממצוק בגובה h במהירות v0 בזווית θ מעל האופק. מתי הוא פוגע בקרקע (y = 0)? אין התנגדות אוויר", "goal": "t = ( v0·sinθ + √( (v0·sinθ)² + 2gh ) ) / g",
      "vars": { "h": [5, 40], "v0": [5, 25], "th": [0.2, 1.2], "g": [9.6, 10], "t": [0.5, 5] }, "mode": "solve", "unknown": "t", "scan": [-30, 30], "udom": "t > 0",
      "startF": "h + v0*sin(th)*t - g*t^2/2 = 0",
      "goalF": "t = (v0*sin(th) + sqrt((v0*sin(th))^2 + 2*g*h))/g",
      "steps": [
        { "f": "g*t^2/2 - v0*sin(th)*t - h = 0", "n": "מציבים y = 0 ומסדרים כך שהמקדם של t² חיובי.",
          "w": [ { "f": "g*t^2/2 + v0*sin(th)*t - h = 0", "e": "sign" }, { "f": "g*t^2/2 - v0*cos(th)*t - h = 0", "e": "axis" }, { "f": "g*t^2 - v0*sin(th)*t - h = 0", "e": "factor" } ] },
        { "f": "t^2 - (2*v0*sin(th)/g)*t - 2*h/g = 0", "n": "מחלקים את כל המשוואה ב־g/2.",
          "w": [ { "f": "t^2 - (v0*sin(th)/g)*t - 2*h/g = 0", "e": "factor" }, { "f": "t^2 - (2*v0*sin(th)/g)*t - h/g = 0", "e": "factor" }, { "f": "t^2 - (2*v0*sin(th))*t - 2*h/g = 0", "e": "partial" } ] },
        { "f": "(t - v0*sin(th)/g)^2 = (v0*sin(th)/g)^2 + 2*h/g", "n": "משלימים לריבוע: מוסיפים את (v0 sinθ / g)² לשני האגפים.",
          "w": [ { "f": "(t - v0*sin(th)/g)^2 = 2*h/g", "e": "dropped" }, { "f": "(t - v0*sin(th)/g)^2 = (v0*sin(th)/g)^2 - 2*h/g", "e": "sign" }, { "f": "(t - 2*v0*sin(th)/g)^2 = (v0*sin(th)/g)^2 + 2*h/g", "e": "factor" } ] },
        { "f": "t = v0*sin(th)/g + sqrt((v0*sin(th)/g)^2 + 2*h/g) or t = v0*sin(th)/g - sqrt((v0*sin(th)/g)^2 + 2*h/g)", "n": "שורש משני האגפים נותן שתי אפשרויות, ואחר כך מעבירים את v0 sinθ / g.", "typed": false,
          "w": [ { "f": "t = v0*sin(th)/g - sqrt((v0*sin(th)/g)^2 + 2*h/g)", "e": "premature" }, { "f": "t = sqrt((v0*sin(th)/g)^2 + 2*h/g) or t = -sqrt((v0*sin(th)/g)^2 + 2*h/g)", "e": "dropped" }, { "f": "t = v0*sin(th)/g + sqrt(v0*sin(th)/g + 2*h/g) or t = v0*sin(th)/g - sqrt(v0*sin(th)/g + 2*h/g)", "e": "power" } ] },
        { "f": "t = (v0*sin(th) + sqrt((v0*sin(th))^2 + 2*g*h))/g", "n": "הזמן חייב להיות חיובי. השורש גדול מ־v0 sinθ / g, ולכן הפתרון עם המינוס שלילי ונפסל.",
          "w": [ { "f": "t = (v0*sin(th) - sqrt((v0*sin(th))^2 + 2*g*h))/g", "e": "premature" }, { "f": "t = (v0*sin(th) + sqrt((v0*sin(th))^2 - 2*g*h))/g", "e": "sign" }, { "f": "t = (v0*sin(th) + sqrt((v0*sin(th))^2 + 2*g*h))/(2*g)", "e": "factor" } ] }
      ],
      "key": [0, 1, 2]
    },
    {
      "id": "dv-p-03", "subject": "physics", "title": "הטווח המרבי בזווית 45° והסיבה לכך", "sym": { "th": "θ" },
      "start": "קליע נזרק במהירות v0 בזווית θ באותו גובה שבו הוא נוחת. זמן הטיסה הוא T = 2·v0·sinθ / g, והטווח R הוא המהירות האופקית כפול T", "goal": "R = v0²·sin(2θ)/g ≤ v0²/g, ושוויון רק כש־ θ = 45°",
      "vars": { "v0": [5, 30], "th": [0.3, 1.2], "g": [9.6, 10] }, "defs": { "T": "2*v0*sin(th)/g", "R": "v0*cos(th)*T" }, "mode": "identity",
      "goalF": "R <= v0^2/g",
      "steps": [
        { "f": "R = v0*cos(th)*T", "n": "המהירות האופקית קבועה, אז הטווח הוא v0·cosθ כפול זמן הטיסה.",
          "w": [ { "f": "R = v0*sin(th)*T", "e": "axis" }, { "f": "R = v0*T", "e": "axis" }, { "f": "R = v0*cos(th)*T^2", "e": "power" } ] },
        { "f": "R = v0*cos(th)*2*v0*sin(th)/g", "n": "מציבים את זמן הטיסה.",
          "w": [ { "f": "R = v0*cos(th)*2*v0*sin(th)*g", "e": "invert" }, { "f": "R = v0*cos(th)*v0*sin(th)/g", "e": "factor" }, { "f": "R = v0*cos(th)*2*v0*cos(th)/g", "e": "axis" } ] },
        { "f": "R = v0^2*(2*sin(th)*cos(th))/g", "n": "אוספים את v0·v0 = v0², ושומרים את 2·sinθ·cosθ יחד.",
          "w": [ { "f": "R = v0^2*(2*sin(th) + cos(th))/g", "e": "linear" }, { "f": "R = v0*(2*sin(th)*cos(th))/g", "e": "power" }, { "f": "R = v0^2*(sin(th)*cos(th))/g", "e": "factor" } ] },
        { "f": "R = v0^2*sin(2*th)/g", "n": "זהות הזווית הכפולה: 2 sinθ cosθ = sin 2θ.",
          "w": [ { "f": "R = v0^2*sin(th)^2/g", "e": "power" }, { "f": "R = v0^2*2*sin(th)/g", "e": "linear" }, { "f": "R = v0^2*cos(2*th)/g", "e": "swap" } ] },
        { "f": "R <= v0^2/g", "n": "sin 2θ אף פעם לא גדול מ־1, ולכן הטווח לא עובר את v0²/g.",
          "w": [ { "f": "R <= v0^2/(4*g)", "e": "factor" }, { "f": "R >= v0^2/g", "e": "sign" }, { "f": "R <= v0/g", "e": "power" } ] },
        { "f": "sin(2*th) = 1 or R < v0^2/g", "n": "השוויון קורה רק כש־ sin 2θ = 1, כלומר 2θ = 90° ו־θ = 45°. בכל זווית אחרת הטווח קטן יותר.", "typed": false,
          "w": [ { "f": "R = v0^2/g", "e": "premature" }, { "f": "sin(2*th) = 1 or R > v0^2/g", "e": "sign" }, { "f": "cos(2*th) = 1 or R > v0^2/g", "e": "swap" } ] }
      ],
      "key": [1, 3, 4]
    },
    {
      "id": "dv-p-04", "subject": "physics", "title": "v² = v0² + 2ax מתוך v(t) ו־x(t)", "sym": {},
      "start": "תאוצה קבועה a. נתון: v = v0 + a·t ו־ x = v0·t + ½·a·t². מחפשים קשר בלי זמן", "goal": "v² = v0² + 2·a·x",
      "vars": { "v0": [1, 10], "a": [-3, 3], "t": [0.2, 3] }, "defs": { "v": "v0 + a*t", "x": "v0*t + a*t^2/2" }, "mode": "identity",
      "goalF": "v^2 = v0^2 + 2*a*x",
      "steps": [
        { "f": "v^2 = (v0 + a*t)^2", "n": "מעלים את v = v0 + a·t בריבוע.",
          "w": [ { "f": "v^2 = v0^2 + a^2*t^2", "e": "cross" }, { "f": "v^2 = v0 + a*t^2", "e": "power" }, { "f": "v^2 = (v0^2 + a*t)^2", "e": "power" } ] },
        { "f": "v^2 = v0^2 + 2*v0*a*t + a^2*t^2", "n": "פותחים בנוסחת הכפל המקוצר, כולל האיבר האמצעי 2·v0·a·t.",
          "w": [ { "f": "v^2 = v0^2 + v0*a*t + a^2*t^2", "e": "factor" }, { "f": "v^2 = v0^2 - 2*v0*a*t + a^2*t^2", "e": "sign" }, { "f": "v^2 = v0^2 + a^2*t^2", "e": "cross" } ] },
        { "f": "v^2 - v0^2 = 2*a*t*(v0 + a*t/2)", "n": "מעבירים את v0² ומוציאים 2·a·t גורם משותף.",
          "w": [ { "f": "v^2 - v0^2 = 2*a*t*(v0 + a*t)", "e": "factor" }, { "f": "v^2 - v0^2 = 2*a*(v0 + a*t/2)", "e": "dropped" }, { "f": "v^2 - v0^2 = a*t*(v0 + a*t/2)", "e": "factor" } ] },
        { "f": "v^2 - v0^2 = 2*a*(v0*t + a*t^2/2)", "n": "מכניסים את t פנימה: בסוגריים מופיעה בדיוק הנוסחה של x.",
          "w": [ { "f": "v^2 - v0^2 = 2*a*(v0*t + a*t^2)", "e": "factor" }, { "f": "v^2 - v0^2 = 2*a*(v0*t + a*t/2)", "e": "power" }, { "f": "v^2 - v0^2 = 2*(v0*t + a*t^2/2)", "e": "dropped" } ] },
        { "f": "v^2 = v0^2 + 2*a*x", "n": "הביטוי בסוגריים הוא x, והזמן נעלם.",
          "w": [ { "f": "v^2 = v0^2 + a*x", "e": "factor" }, { "f": "v^2 = v0^2 - 2*a*x", "e": "sign" }, { "f": "v^2 = v0 + 2*a*x", "e": "power" } ] }
      ],
      "key": [1, 2, 3]
    },
    {
      "id": "dv-p-05", "subject": "physics", "title": "זמן המפגש של שני גופים שנעים זה לקראת זה", "sym": { "vA": "v<sub>A</sub>", "vB": "v<sub>B</sub>", "t0": "t<sub>0</sub>" },
      "start": "מכונית A יוצאת מהראשית בזמן 0 במהירות vA. מכונית B נמצאת במרחק d ממנה ויוצאת לקראתה במהירות vB רק בזמן t0. מתי הן נפגשות?", "goal": "t = ( d + vB·t0 ) / ( vA + vB )",
      "vars": { "vA": [10, 30], "vB": [10, 30], "d": [100, 500], "t0": [0, 5], "t": [1, 20] }, "mode": "solve", "unknown": "t", "scan": [-100, 100],
      "goalF": "t = (d + vB*t0)/(vA + vB)",
      "steps": [
        { "f": "vA*t = d - vB*(t - t0)", "n": "המיקומים שווים: A עברה vA·t, ו־B עברה מרחק vB לאורך (t − t0) בלבד, כי היא יצאה באיחור.",
          "w": [ { "f": "vA*t = d - vB*t - t0", "e": "paren" }, { "f": "vA*t = d + vB*(t - t0)", "e": "sign" }, { "f": "vA*t = d - vB*(t + t0)", "e": "sign" } ] },
        { "f": "vA*t = d - vB*t + vB*t0", "n": "פותחים סוגריים: המינוס מתחלק על שני האיברים, ולכן −vB·(−t0) = +vB·t0.",
          "w": [ { "f": "vA*t = d - vB*t - vB*t0", "e": "paren" }, { "f": "vA*t = d - vB*t + t0", "e": "paren" }, { "f": "vA*t = d - vB*t0 + vB*t", "e": "sign" } ] },
        { "f": "vA*t + vB*t = d + vB*t0", "n": "מעבירים את האיבר עם t לאגף שמאל.",
          "w": [ { "f": "vA*t - vB*t = d + vB*t0", "e": "sign" }, { "f": "vA*t + vB*t = d - vB*t0", "e": "sign" }, { "f": "vA*t + vB*t = d", "e": "dropped" } ] },
        { "f": "(vA + vB)*t = d + vB*t0", "n": "מוציאים t גורם משותף.",
          "w": [ { "f": "(vA - vB)*t = d + vB*t0", "e": "sign" }, { "f": "vA*vB*t = d + vB*t0", "e": "quantity" }, { "f": "(vA + vB)*t = d + t0", "e": "dropped" } ] },
        { "f": "t = (d + vB*t0)/(vA + vB)", "n": "מחלקים במהירות היחסית של התקרבות, vA + vB.",
          "w": [ { "f": "t = (d + vB*t0)*(vA + vB)", "e": "invert" }, { "f": "t = (d - vB*t0)/(vA + vB)", "e": "sign" }, { "f": "t = d + vB*t0/(vA + vB)", "e": "paren" } ] }
      ],
      "key": [1, 2, 3]
    },
    {
      "id": "dv-p-06", "subject": "physics", "title": "שיפוע ושטח בגרף מהירות־זמן", "sym": { "dt": "Δt", "v1": "v<sub>1</sub>", "v2": "v<sub>2</sub>" },
      "start": "בגרף v(t) קו ישר עולה מ־v1 ל־v2 במשך Δt. מוכיחים: השיפוע הוא התאוצה והשטח מתחת לגרף הוא ההעתק", "goal": "שיפוע = a , שטח = v1·Δt + ½·a·Δt²",
      "vars": { "v1": [1, 10], "a": [-3, 3], "dt": [0.5, 5] }, "defs": { "v2": "v1 + a*dt", "A": "v1*dt + (v2 - v1)*dt/2" }, "mode": "identity",
      "goalF": "A = v1*dt + a*dt^2/2",
      "steps": [
        { "f": "(v2 - v1)/dt = a", "n": "שיפוע הוא שינוי בציר האנכי חלקי שינוי בציר האופקי, וזו בדיוק ההגדרה של תאוצה.",
          "w": [ { "f": "(v2 - v1)*dt = a", "e": "invert" }, { "f": "(v2 + v1)/dt = a", "e": "sign" }, { "f": "(v2 - v1)/2 = a", "e": "quantity" } ] },
        { "f": "A = v1*dt + (v2 - v1)*dt/2", "n": "השטח מתחת לגרף: מלבן שגובהו v1 ועליו משולש שבסיסו Δt וגובהו v2 − v1.",
          "w": [ { "f": "A = v1*dt + (v2 - v1)*dt", "e": "factor" }, { "f": "A = v1*dt + (v2 - v1)/2", "e": "dropped" }, { "f": "A = v1*dt - (v2 - v1)*dt/2", "e": "sign" } ] },
        { "f": "A = (v1 + v2)/2*dt", "n": "אותו שטח כטרפז: ממוצע שני הבסיסים כפול הרוחב.",
          "w": [ { "f": "A = (v1 + v2)*dt", "e": "factor" }, { "f": "A = (v1 + v2)/2", "e": "dropped" }, { "f": "A = (v1 - v2)/2*dt", "e": "sign" } ] },
        { "f": "A = (v1 + (v1 + a*dt))/2*dt", "n": "מציבים v2 = v1 + a·Δt, מתוך השיפוע.",
          "w": [ { "f": "A = (v1 + (v1 + a*dt))/2", "e": "dropped" }, { "f": "A = (v1 + a*dt)/2*dt", "e": "partial" }, { "f": "A = (v1 + (v1 + a))/2*dt", "e": "quantity" } ] },
        { "f": "A = v1*dt + a*dt^2/2", "n": "מאחדים: (2·v1 + a·Δt)/2 · Δt.",
          "w": [ { "f": "A = v1*dt + a*dt/2", "e": "power" }, { "f": "A = v1*dt + a*dt^2", "e": "factor" }, { "f": "A = v1*dt - a*dt^2/2", "e": "sign" } ] }
      ],
      "key": [1, 2, 3]
    },
    {
      "id": "dv-p-07", "subject": "physics", "title": "מרחק עצירה עם חיכוך", "sym": { "mu": "μ" },
      "start": "גוף במסה m מחליק על משטח אופקי עם מקדם חיכוך μ, ומתחיל במהירות v0. N = כוח נורמל, f = חיכוך, a = גודל ההאטה, T = זמן עצירה, d = מרחק עצירה", "goal": "d = v0² / (2·μ·g)",
      "vars": { "v0": [5, 30], "mu": [0.1, 0.9], "g": [9.6, 10], "m": [1, 20] },
      "defs": { "N": "m*g", "f": "mu*N", "a": "f/m", "T": "v0/a", "d": "v0/2*T" }, "mode": "identity",
      "goalF": "d = v0^2/(2*mu*g)",
      "steps": [
        { "f": "N = m*g", "n": "במשטח אופקי אין תאוצה אנכית, אז הנורמל מאזן את המשקל.",
          "w": [ { "f": "N = m*mu*g", "e": "quantity" }, { "f": "N = m", "e": "dropped" }, { "f": "N = m/g", "e": "invert" } ] },
        { "f": "f = mu*m*g", "n": "חיכוך קינטי הוא μ כפול הנורמל.",
          "w": [ { "f": "f = mu*m", "e": "dropped" }, { "f": "f = m*g/mu", "e": "invert" }, { "f": "f = mu*g", "e": "dropped" } ] },
        { "f": "a = mu*g", "n": "החיכוך הוא הכוח השקול, ולכן a = f/m. המסה מצטמצמת.",
